{
  "name": "pmi-south-asia",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "convex": "^1.31.2",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @pmi-south-asia/backend dev",
    "dev:setup": "turbo -F @pmi-south-asia/backend dev:setup",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only"
  },
  "dependencies": {
    "@pmi-south-asia/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@pmi-south-asia/config": "workspace:*",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.0.10"
  },
  "packageManager": "bun@1.3.5"
}